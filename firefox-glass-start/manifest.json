{
  "manifest_version": 3,
  "name": "GX Glass Start for Firefox",
  "short_name": "GX Glass Start",
  "version": "1.0.0",
  "description": "A customizable Firefox new-tab page with quick-link folders, RSS feeds, and drag-and-drop layout.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Open GX Glass Start"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "commands": {
    "open-dashboard": {
      "description": "Open GX Glass Start dashboard"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "gx-glass-start-firefox@example.com",
      "strict_min_version": "109.0"
    }
  }
}
